---
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import DocsLayout from '../layouts/DocsLayout.astro';
import { getPublishedPosts } from '../utils/posts';

// 首页就是文章列表，不再单独做一个 hero 落地页：
// 多一层「首页 → 全部文章」对写作者和读者都是纯开销。
// 分页在阶段 4 接进来（paginate() 会接管这个路由）。
const posts = await getPublishedPosts();

// 传 SITE_TITLE 作为标题：BaseHead 判断到 title === SITE_TITLE 就不再拼后缀，
// 首页标题因此是「gegedda」而不是「gegedda · gegedda」。
---

<DocsLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<header class="home-header">
		<h1 class="home-header__title">{SITE_TITLE}</h1>
		<p class="home-header__desc">{SITE_DESCRIPTION}</p>
	</header>

	<PostList posts={posts} featuredFirst />
</DocsLayout>

<style>
	.home-header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}
	.home-header__title {
		margin: 0 0 0.4rem;
		font-size: 1.9rem;
		line-height: 1.3;
	}
	.home-header__desc {
		margin: 0;
		color: var(--fg-muted);
		/* 导语限制到 30em，否则在宽屏上会拉成一整行很长的中文 */
		max-width: 30em;
	}
</style>
