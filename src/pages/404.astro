---
import Footer from '../components/Footer.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// 这个文件的存在本身就是功能：没有它，构建产物里就没有 dist/404.html，
// Cloudflare Pages 会退回到「任何未知路径都返回首页 + HTTP 200」（软 404），
// 搜索引擎于是把无数个重复首页都收进索引。
//
// 刻意用 BaseLayout 而不是 DocsLayout：给一个「找不到页面」配上完整的
// 文章树和目录，等于把读者从目标内容上引开。只留页头和一个出口。
---

<BaseLayout title="页面不存在" description="你访问的页面不存在或已被移动。" noindex>
	<SiteHeader />
	<main id="main" class="not-found">
		<p class="not-found__code">404</p>
		<h1 class="not-found__title">这个页面不存在</h1>
		<p class="not-found__text">链接可能已经失效，或者地址输错了。</p>
		<nav class="not-found__links" aria-label="出口">
			<a href="/">返回首页</a>
			<a href="/blog/">浏览全部文章</a>
		</nav>
	</main>
	<Footer />
</BaseLayout>

<style>
	.not-found {
		max-width: 34rem;
		margin-inline: auto;
		padding: 5rem 1rem 0;
		text-align: center;
	}
	.not-found__code {
		margin: 0;
		color: var(--fg-subtle);
		font-size: 3.5rem;
		font-weight: 700;
		line-height: 1;
		font-variant-numeric: tabular-nums;
	}
	.not-found__title {
		margin: 0.4em 0 0.5em;
		font-size: 1.6rem;
	}
	.not-found__text {
		margin: 0;
		color: var(--fg-muted);
	}
	.not-found__links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.5rem;
		margin-top: 2rem;
	}
	.not-found__links a {
		font-weight: 600;
	}
</style>
