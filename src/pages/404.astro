---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

// 这个文件的存在本身就是功能：没有它，构建产物里就没有 dist/404.html，
// Cloudflare Pages 会退回到「任何未知路径都返回首页 + HTTP 200」（软 404），
// 搜索引擎于是把无数个重复首页都收进索引。
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title="页面不存在" description="你访问的页面不存在或已被移动。" />
		<meta name="robots" content="noindex" />
		<style>
			main {
				max-width: 640px;
				padding: 4em 0;
				text-align: center;
			}
			.code {
				margin: 0;
				font-size: 4rem;
				line-height: 1;
				color: rgb(var(--gray));
			}
			h1 {
				margin: 0.3em 0 0.5em;
				font-size: 1.8rem;
			}
			p {
				color: rgb(var(--gray));
			}
			.links {
				margin-top: 2em;
				display: flex;
				gap: 1.5em;
				justify-content: center;
				flex-wrap: wrap;
			}
			.links a {
				color: rgb(var(--accent));
				font-weight: 600;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<p class="code">404</p>
			<h1>这个页面不存在</h1>
			<p>链接可能已经失效，或者地址输错了。</p>
			<div class="links">
				<a href="/">返回首页</a>
				<a href="/blog/">浏览全部文章</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
