---
import NotFound from '../../components/NotFound.astro';
import PostList from '../../components/PostList.astro';
import { countPublishedPostsByTag, getTagBySegment, listPublishedPostsByTag } from '../../data/posts.repo';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { getDb } from '../../lib/db';

/**
 * 单个标签下的文章列表。
 *
 * 改造前 `getStaticPaths` 在构建期把「标签 → 文章」算好当 props 传进来，
 * 并顺带把标签的**显示名**也传进来。SSR 下两件事都要查库：
 *
 *  - URL 里的片段是**规范形式**（`hello-world`），显示名是 frontmatter 里的
 *    原文（`Hello World`），两者对不上。拿片段去比对文章标签会一篇都筛不出来，
 *    页面看着正常、只是空的——所以要先 `getTagBySegment` 换回显示名，
 *    再用 `segment` 去筛（库里两列都有，筛的那列是 segment）。
 *
 *  - 标签不存在时要 404。改造前这个地址在构建期就不存在；现在
 *    `/tags/随便什么/` 会落进这个路由。
 */
const db = getDb();

// 路由参数是解码后的形式（Astro 先解码再匹配），与 tagParam 的约定一致。
const segment = Astro.params.tag;
const tag = segment ? await getTagBySegment(db, segment) : null;

const posts = tag ? await listPublishedPostsByTag(db, segment!) : [];
const total = tag ? await countPublishedPostsByTag(db, segment!) : 0;

if (!tag) {
	Astro.response.status = 404;
}
---

{
	tag ? (
		<DocsLayout title={`标签：${tag.tag}`} description={`带有「${tag.tag}」标签的全部文章。`}>
			<header class="list-header">
				<h1 class="list-header__title">{tag.tag}</h1>
				<p class="list-header__count">
					共 {total} 篇 · <a href="/tags/">全部标签</a>
				</p>
			</header>

			<PostList posts={posts} />
		</DocsLayout>
	) : (
		<NotFound />
	)
}

{/*
	用 DocsLayout 而不是 PageLayout：PageLayout 把内容包进 .prose（38em），
	那是给正文用的宽度，套在两个卡片的杂志式网格上会把每列压到 300px 左右。
	凡是渲染 PostList 的页面都走宽栏。
*/}

<style>
	.list-header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}
	.list-header__title {
		margin: 0 0 0.4rem;
		font-size: 1.9rem;
		line-height: 1.3;
	}
	.list-header__count {
		margin: 0;
		color: var(--fg-subtle);
		font-size: 0.9rem;
	}
</style>
