---
import type { GetStaticPaths } from 'astro';
import PostList from '../../components/PostList.astro';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { collectTags, getPublishedPosts, type Post, type TagCount } from '../../utils/posts';

export const getStaticPaths = (async () => {
	const posts = await getPublishedPosts();

	/**
	 * params 用 item.param（解码形式），不是 item.slug（编码形式）——
	 * Astro 收到 params 后会先解码再匹配路由，传编码过的会直接构建失败。
	 * 详见 utils/posts.ts 里 tagParam 的注释。
	 *
	 * 标签名另外通过 props 传给页面，而不是让页面从 params.tag 反解：
	 * params 里是 hello-world 这种规范形式，和 frontmatter 里的 `Hello World`
	 * 对不上，拿它去比对会一篇都筛不出来。这里直接传原始标签，
	 * 顺带把「每个标签对应哪些文章」在构建期算好。
	 */
	return collectTags(posts).map((item: TagCount) => ({
		params: { tag: item.param },
		props: {
			tag: item.tag,
			posts: posts.filter((post: Post) =>
				(post.data.tags ?? []).some((t) => t.trim() === item.tag),
			),
		},
	}));
}) satisfies GetStaticPaths;

interface Props {
	tag: string;
	posts: Post[];
}

const { tag, posts } = Astro.props;
---

{/*
	用 DocsLayout 而不是 PageLayout：PageLayout 把内容包进 .prose（38em），
	那是给正文用的宽度，套在两个卡片的杂志式网格上会把每列压到 300px 左右。
	凡是渲染 PostList 的页面都走宽栏。
*/}
<DocsLayout title={`标签：${tag}`} description={`带有「${tag}」标签的全部文章。`}>
	<header class="list-header">
		<h1 class="list-header__title">{tag}</h1>
		<p class="list-header__count">
			共 {posts.length} 篇 · <a href="/tags/">全部标签</a>
		</p>
	</header>

	<PostList posts={posts} />
</DocsLayout>

<style>
	.list-header {
		margin-bottom: 2.5rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}
	.list-header__title {
		margin: 0 0 0.4rem;
		font-size: 1.9rem;
		line-height: 1.3;
	}
	.list-header__count {
		margin: 0;
		color: var(--fg-subtle);
		font-size: 0.9rem;
	}
</style>
