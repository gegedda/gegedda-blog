---
import PostMeta from '../components/PostMeta.astro';
import PostNav from '../components/PostNav.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagChips from '../components/TagChips.astro';
import { heroImageSrc, type Post } from '../domain/post';
import type { Heading } from '../utils/toc';
import DocsLayout from './DocsLayout.astro';

interface Props {
	post: Post;
	/** 来自 `post.headings`（D1 的 headings_json 缓存列） */
	headings: Heading[];
	older?: Post;
	newer?: Post;
}

const { post, headings, older, newer } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;
const heroSrc = heroImageSrc(heroImage);
---

<DocsLayout title={title} description={description} ogType="article">
	<article>
		{/*
			用原生 <img> 而不是 astro:assets 的 <Image>：`heroImage` 现在是
			frontmatter 里的路径原文（字符串），不再是被 `image()` 解析过的
			ImageMetadata，<Image> 接不了它。

			而且接得了也没用——适配器的 imageService 必须是 'passthrough'
			（见 astro.config.mjs，默认值是付费的 Cloudflare Images），
			在 passthrough 下 <Image> 本来就不做任何缩放或转格式。

			width/height 必须显式写：浏览器靠它们预留位置，缺失会让图片加载完
			之后整页重排（CLS 变差）。它们是布局尺寸，不是图片的真实尺寸，
			真实的缩放由 P6 上 R2 后做。
		*/}
		{
			heroSrc && (
				<img
					class="post-hero"
					src={heroSrc}
					alt=""
					width="1200"
					height="600"
					loading="eager"
					fetchpriority="high"
					decoding="async"
				/>
			)
		}

		<header class="post-header">
			<h1 class="post-header__title">{title}</h1>
			<PostMeta pubDate={pubDate} updatedDate={updatedDate} words={post.words} minutes={post.minutes} />
			<TagChips tags={tags} />
		</header>

		{/*
			正文来自 D1 的 body_html 缓存列，导入时就由 shared/markdown.ts 渲染好了。
			读者请求只做「读出来 + 套模板」，不重跑渲染管线——Workers 免费版
			每个请求只有 10ms CPU，而 shiki 高亮一篇带代码块的文章远超这个数。

			set:html 是安全的：这段 HTML 是我们自己的渲染管线从博主自己写的
			Markdown 生成的，不是用户提交的内容。
		*/}
		<div class="prose" set:html={post.bodyHtml} />

		<PostNav older={older} newer={newer} />
	</article>

	<Fragment slot="rail">
		<TableOfContents headings={headings} />
	</Fragment>
</DocsLayout>

<style>
	.post-hero {
		display: block;
		width: 100%;
		height: auto;
		margin-bottom: 2rem;
		border-radius: var(--r-lg);
	}

	.post-header {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		margin-bottom: 2.25rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
	}
	.post-header__title {
		margin: 0;
		/* 文章标题比正文里的 h1 略大，但不走 3em 那套——中文标题在
		   61px 下每个字都是一块墨，扫读时反而吃力 */
		font-size: 1.9rem;
		line-height: 1.3;
	}
</style>
