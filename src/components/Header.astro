---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<div class="site-name"><a href="/">{SITE_TITLE}</a></div>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		{/* TODO: 在此添加你的社交链接（GitHub / 微博 / 知乎等） */}
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	/* 站名不是标题：它出现在每页 h1 之前，用标题标签会打乱文档大纲 */
	.site-name {
		margin: 0;
		font-size: 1em;
	}

	.site-name a,
	.site-name a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	@media (max-width: 720px) {
		nav {
			justify-content: center;
			gap: 1em;
			flex-wrap: wrap;
			padding: 0.5em 0;
		}
		nav a {
			padding: 0.6em 0.5em;
		}
	}
</style>
