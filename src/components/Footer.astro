---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {SITE_TITLE}. 保留所有权利。
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		/* 渐变带去掉：它在 body 和 footer 上各画了一次（双重色带），
		   在三栏布局里还会和 sticky 侧栏打架。 */
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.9rem;
	}
</style>
