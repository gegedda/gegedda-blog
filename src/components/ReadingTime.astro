---
import Icon from './Icon.astro';

interface Props {
	/**
	 * 来自 posts 表的缓存列 `words` / `minutes`，导入时就算好了。
	 *
	 * 这里**刻意不接受 Markdown 原文去现算**：那会每次请求重跑三个正则扫全文，
	 * 而 Workers 免费版每个请求只有 10ms CPU。更要紧的是，现算会引入第二份
	 * 字数实现——后台预览算一个数、读者看到一个数，两边不一样且不会报错。
	 */
	words: number;
	minutes: number;
}

const { words, minutes } = Astro.props;
---

{
	words > 0 && (
		<span class="reading-time">
			<Icon name="words" />
			{/* toLocaleString 让四位以上的数字有千位分隔（1,234 字） */}
			<span>{words.toLocaleString('zh-CN')} 字</span>
			<span class="reading-time__sep" aria-hidden="true">
				·
			</span>
			<span>约 {minutes} 分钟</span>
		</span>
	)
}

<style>
	.reading-time {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--fg-subtle);
		font-size: 0.9rem;
		font-variant-numeric: tabular-nums;
	}
	.reading-time__sep {
		color: var(--border-strong);
	}
	.reading-time :global(.icon) {
		width: 0.95em;
		height: 0.95em;
	}
</style>
