---
/**
 * 线性图标。24×24 视口，用 currentColor 描边，所以颜色由外层文字色决定。
 *
 * 用 set:html 而不是 <slot />：图标是多元素组合（圆 + 射线），
 * 拆成「一个 name 对应一条 path」会立刻不够用。这些字符串全是本文件里的
 * 字面量、不接受任何外部输入，因此没有注入面。
 */
interface Props {
	name: keyof typeof ICONS;
	class?: string;
	/** 有文字标签时保持 true；纯装饰性图标由外层 aria-label 兜底 */
	label?: string;
}

const ICONS = {
	sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
	moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>',
	monitor:
		'<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
	'arrow-left': '<path d="M19 12H5M12 19l-7-7 7-7"/>',
	'arrow-right': '<path d="M5 12h14M12 5l7 7-7 7"/>',
	calendar:
		'<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M8 2v4M16 2v4M3 10h18"/>',
	clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
	words: '<path d="M4 7V5h16v2M12 5v14M9 19h6"/>',
	rss: '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
	tag: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1"/>',
} as const;

const { name, class: className, label } = Astro.props;
---

<svg
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.75"
	stroke-linecap="round"
	stroke-linejoin="round"
	class:list={['icon', className]}
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	set:html={ICONS[name]}
/>
