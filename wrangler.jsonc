{
  // 这是 Cloudflare 侧的部署配置。Astro 的 Cloudflare adapter 会读它。
  //
  // name 与 Pages 项目名（gegedda-blog）**故意不同**：
  // 改造期间原 Pages 项目继续服务线上静态站，新 Worker 用新名字并行上线，
  // 到 P7 才切换。这就是整个改造的干净回滚点。
  "name": "gegedda-blog-ssr",

  // 兼容性日期。定下来之后不要再改——它决定了运行时行为按哪一天的规范执行，
  // 改动等于把全站的行为基线挪一次。
  "compatibility_date": "2026-09-21",

  // 只保留一条绑定，且 binding 必须是 DB：
  // src/lib/db.ts 的 getDb() 读的就是 env.DB。
  //
  // 注意：`wrangler d1 create` 见到已有配置文件时会**自动追加**一条绑定。
  // 本项目在建库时已经被追加过一次，出现了同一个 database_id 的两条绑定
  // （其中一条还带着非法的 "remote": true 字段）。重复绑定不会报错，
  // 但会让「到底哪条生效」变得不确定。以后再用 wrangler 建资源时留意这点。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gegedda-blog-db",
      "database_id": "f2ff487a-0c06-4d51-9cc9-5b8519079656"
    }
  ]
}
